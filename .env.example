# Used by docker-compose.yml (NOT backend/.env) to make the stack reachable
# from other devices on your LAN, e.g. for sharing a demo with teammates.
#
# Set this to the host machine's LAN IP (find it with `hostname -I` on
# Linux or `ipconfig` on Windows). Leave unset / commented out for normal
# localhost-only development — everything defaults to localhost.
#
# LAN_HOST=192.168.1.50
