ENVIRONMENT=development

# Postgres connection. When running via docker-compose this is overridden to
# point at the "postgres" service; this value is used for local (non-docker) dev.
DATABASE_URL=postgresql+psycopg2://ats:ats@localhost:5433/ats

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI providers -----------------------------------------------------------
# Everything defaults to "mock" so the whole product works with zero API keys.
#
# LLM_PROVIDER / EMBEDDING_PROVIDER: "mock" | "openai" | "gemini" | "auto"
#   - "openai" / "gemini": pin to that provider (rotates across multiple keys
#     below if you supply more than one, for resilience against rate limits).
#   - "auto" (LLM only): rotate across EVERY configured provider's keys —
#     if OpenAI is rate-limited/down, requests automatically fail over to
#     Gemini and vice versa. (Embeddings can't mix providers in one pgvector
#     column, so "auto" there just auto-picks whichever single provider has
#     keys configured, still rotating across multiple keys of that provider.)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# Supply one key OR several comma-separated keys (both can be set at once —
# they're merged into one pool): OPENAI_API_KEYS=sk-aaa,sk-bbb,sk-ccc
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-1.5-flash

EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Must match the chosen embedding model's real output size (OpenAI
# text-embedding-3-small=1536, Gemini text-embedding-004=768, mock=384) —
# changing it for an existing database requires an Alembic migration to
# resize the embeddings.vector pgvector column.
EMBEDDING_DIM=384

# How long (seconds) a failed key is skipped before being retried.
KEY_COOLDOWN_SECONDS=60

# --- CV scanning / OCR -------------------------------------------------------
# "tesseract": free/offline OCR (default fallback, always available).
# "llm_vision": send the scanned page to a vision-capable model from the pool
#   above (only used when a real LLM key is configured).
# "auto": try Tesseract first; if the result looks too short AND a real LLM
#   key is configured, retry with llm_vision.
OCR_PROVIDER=auto
OCR_MIN_TEXT_LENGTH=40
OCR_MAX_PAGES=5

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
